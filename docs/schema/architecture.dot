digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.15", nodesep="0.35", ranksep="0.65", splines=spline, fontname="DejaVu Sans"];
  node [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#F1F5F9", color="#CBD5E1", fontcolor="#17324D", penwidth=1.3, margin="0.18,0.12"];
  edge [color="#7C8DA0", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9, fontcolor="#56667A"];
  user [label="Client local\nHTTP / HTTPS", fillcolor="#DBEAFE", color="#60A5FA"];
  traefik [label="TRAEFIK 3.7.17\n:80 / :443", fillcolor="#0F3A59", fontcolor="white", color="#0F3A59"];
  admin [label="Administration locale\n127.0.0.1:8080", fillcolor="#FDE68A", color="#D97706"];
  service1 [label="Router Host(app1.localhost)\nService app1-svc", fillcolor="#DFEAFE", color="#7DA7ED"];
  service2 [label="Router Host(app2.localhost)\nService app2-svc", fillcolor="#DFEAFE", color="#7DA7ED"];
  service3 [label="HTTPS + BasicAuth\nApp3 (profil evolution)", fillcolor="#F5E8FF", color="#AA78D2"];
  app1 [label="Nginx App1 A\nPort interne 8080", fillcolor="#DCFCE7", color="#16A34A"];
  app1b [label="Nginx App1 B\nPort interne 8080", fillcolor="#DCFCE7", color="#16A34A"];
  app2 [label="Nginx App2\nPort interne 8080", fillcolor="#DCFCE7", color="#16A34A"];
  app3 [label="Nginx App3\nPort interne 8080", fillcolor="#DCFCE7", color="#16A34A"];
  user -> traefik [label="80 / 443"];
  admin -> traefik [label="Dashboard / API", style=dashed, color="#D97706"];
  traefik -> service1;
  traefik -> service2;
  traefik -> service3;
  service1 -> app1 [label="Répartition"];
  service1 -> app1b;
  service2 -> app2;
  service3 -> app3;
}
